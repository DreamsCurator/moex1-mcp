# MOEX ISS+ / ALGOPACK
MOEX_WS_URL=wss://iss.moex.com/infocx/v3/websocket
MOEX_DOMAIN=passport
MOEX_LOGIN=
MOEX_PASSCODE=
# либо REST APIKEY (Authorization: Bearer) для ISS; короткий login:passcode тоже принимается:
# MOEX_ALGOPACK_TOKEN=
# Публичный демо-контур ISS+ (ограниченный доступ):
# MOEX_DOMAIN=DEMO
# MOEX_LOGIN=guest
# MOEX_PASSCODE=guest

# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Bot -> MCP
MCP_SERVER_URL=http://mcp_server:8765

LOG_LEVEL=INFO
LOG_DIR=logs

# Bot limits
BOT_RATE_LIMIT_PER_MINUTE=10
BOT_MAX_MESSAGE_CHARS=1500
